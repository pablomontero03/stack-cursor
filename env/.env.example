# ============================================================
# stack-cursor — Variables de entorno (EJEMPLO)
# Copiar este archivo como .env y completar con valores reales.
# .env NO se versiona. .env.example SÍ.
# Los nombres salen del contrato de automation-kiro. No se eliminó
# ninguna variable al migrar el ejemplo.
# ============================================================

# --- Azure DevOps ---
AZURE_DEVOPS_PAT=<PAT de Azure DevOps - Settings > Personal Access Tokens>
AZURE_DEVOPS_ORG=Shared-Service-GM
AZURE_DEVOPS_PROJECT=DevOps

# --- Azure Container Registry ---
CONTAINER_REGISTRY_USERNAME=<username del ACR>
CONTAINER_REGISTRY_PASSWORD=<password del ACR>

# --- n8n interno (monitoreo SQL / Schema Sync) ---
N8N_MCP_URL=http://172.16.2.60:5678/mcp
N8N_MCP_TOKEN=<JWT token de la API de n8n interno>

# --- n8n productivo ---
N8N_PRODUCTIVO_URL=https://automation.grupomontecristo.com
N8N_PRODUCTIVO_MCP_TOKEN=<JWT token de la API de n8n productivo>

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=<API Token de Cloudflare (no Global API Key)>

# --- SQL desarrollo ---
SQL_DEV_SERVER=172.16.2.30
SQL_DEV_DATABASE=buklo_lab
SQL_DEV_USER=<usuario>
SQL_DEV_PASSWORD=<password>

# --- SQL UAT ---
SQL_UAT_SERVER=172.16.2.34
SQL_UAT_DATABASE=buklo_lab
SQL_UAT_USER=<usuario>
SQL_UAT_PASSWORD=<password>

# --- Servidores Linux ---
LINUX_SRV_ADM_IP=172.16.2.31
LINUX_SRV_ADM_USER=<usuario>
LINUX_SRV_ADM_PASS=<password>

N8N_SRV_IP=172.16.2.60
N8N_SRV_USER=<usuario>
N8N_SRV_PASS=<password>

DEV_SRV_IP=172.16.2.43
DEV_SRV_USER=<usuario>
DEV_SRV_PASS=<password>

# --- OpenEdX ---
OPENEDX_IP=<ip del servidor>
OPENEDX_USER=<usuario>
OPENEDX_KEY_PATH=${REPO_ROOT}/env/keyopenedx.pem

# --- MCP de Azure DevOps (derivada) ---
ADO_MCP_AUTH_TOKEN=${AZURE_DEVOPS_PAT}
